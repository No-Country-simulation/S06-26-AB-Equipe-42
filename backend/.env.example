# =============================================================================
# AppBit Painel — Variáveis de Ambiente (Backend)
# Copie este ficheiro para .env e preencha os valores reais.
# NUNCA comite o ficheiro .env para o repositório.
# =============================================================================

# --- Aplicação ---
DEBUG=false

# --- Base de Dados (Supabase / PostgreSQL) ---
# Obtém estas credenciais com o Domingos ou Joel
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# --- Serviço de IA via OpenRouter (GRATUITO) ---
# Registe-se em https://openrouter.ai e gere uma chave gratuita
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo gratuito recomendado (sem custo):
LLM_MODEL=google/gemini-3.5-flash:free

# --- CORS (origens permitidas, separadas por vírgula) ---
# Em desenvolvimento: frontend local
# Em produção: URL do staging no Railway/Render
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
